{
  "permissions": {
    "allow": [
      "Read(~/hogwarts/CLAUDE.md)",
      "Read(~/hogwarts/desks/portrait/**)",
      "Edit(~/hogwarts/desks/portrait/scratchpad.md)",
      "Edit(~/hogwarts/desks/portrait/outbox/**)",
      "mcp__<chat-mcp>__list_messages",
      "mcp__<chat-mcp>__search_conversations",
      "mcp__<chat-mcp>__search_messages"
    ],
    "deny": [
      "Read(~/.hogwarts/**)",
      "Edit(~/.hogwarts/**)",
      "Write(~/.hogwarts/**)",
      "Edit(~/hogwarts/desks/portrait/inbox/**)",
      "Write(~/hogwarts/desks/portrait/inbox/**)",
      "mcp__<chat-mcp>__send_message"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": [
        "/Users/crisryantan/hogwarts/desks/portrait"
      ],
      "denyWrite": [
        "/Users/crisryantan/.hogwarts",
        "/Users/crisryantan/hogwarts/.git",
        "/Users/crisryantan/hogwarts/.claude",
        "/Users/crisryantan/hogwarts/tasks",
        "/Users/crisryantan/hogwarts/worktrees",
        "/Users/crisryantan/hogwarts/CLAUDE.md",
        "/Users/crisryantan/hogwarts/PLAN.md",
        "/Users/crisryantan/hogwarts/standing-orders.md",
        "/Users/crisryantan/hogwarts/.gitignore",
        "/Users/crisryantan/hogwarts/desks/mcgonagall",
        "/Users/crisryantan/hogwarts/desks/harry",
        "/Users/crisryantan/hogwarts/desks/hermione",
        "/Users/crisryantan/hogwarts/desks/moody",
        "/Users/crisryantan/hogwarts/desks/ron",
        "/Users/crisryantan/hogwarts/desks/snape",
        "/Users/crisryantan/hogwarts/desks/portrait/inbox"
      ],
      "denyRead": [
        "/Users/crisryantan/.hogwarts",
        "/Users/crisryantan/.ssh",
        "/Users/crisryantan/.aws",
        "/Users/crisryantan/.codex",
        "/Users/crisryantan/.claude.json",
        "/Users/crisryantan/.claude/.credentials.json",
        "/Users/crisryantan/.claude/settings.json",
        "/Users/crisryantan/.claude/settings.local.json",
        "/Users/crisryantan/.claude/history.jsonl",
        "/Users/crisryantan/.claude/projects",
        "/Users/crisryantan/.netrc",
        "/Users/crisryantan/.npmrc",
        "/Users/crisryantan/.docker",
        "/Users/crisryantan/.kube",
        "/Users/crisryantan/.gnupg",
        "/Users/crisryantan/.config/gh"
      ]
    },
    "network": {
      "allowUnixSockets": [],
      "allowAllUnixSockets": false,
      "allowLocalBinding": false,
      "allowedDomains": []
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env -i /usr/bin/python3 -I -B -X pycache_prefix=/var/empty -c 'import sys; sys.path.insert(0, \"/Users/crisryantan/.hogwarts\"); from fleet.hooks.push_gate import main; sys.exit(main())'",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
